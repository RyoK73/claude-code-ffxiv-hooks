{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__REPO_DIR__/scripts/play.sh FFXIV_Quest_Complete.mp3" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "__REPO_DIR__/scripts/play.sh FFXIV_Guildleve_Complete.mp3" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "__REPO_DIR__/scripts/play.sh FFXIV_Incoming_Tell_1.mp3" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "__REPO_DIR__/scripts/play_bash_result.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "__REPO_DIR__/scripts/play.sh FFXIV_Obtain_Item.mp3" }
        ]
      }
    ]
  }
}
